/*
 * Dark theme for the application chrome, using the colors of
 * ttkbootstrap's "darkly" theme (from Bootswatch Darkly).
 *
 * Palette
 *   background     #222222   bg
 *   input surface  #2f2f2f   inputbg
 *   panel          #303030   dark
 *   text           #ffffff   fg            15.9:1 on #222222
 *   muted text     #adb5bd   light          8.5:1 on #222222
 *   border         #444444   secondary
 *   accent         #375a7f   primary        white text on it 7.2:1
 *   hover          #555555   selectbg
 */

QWidget {
    background-color: #222222;
    color: #ffffff;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 10pt;
    selection-background-color: #375a7f;
    selection-color: #ffffff;
}

QWidget:disabled {
    color: #adb5bd;
}

/* --- Menus ------------------------------------------------------------ */

QMenuBar {
    background-color: #303030;
    border-bottom: 1px solid #444444;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
    background-color: #375a7f;
}

QMenu {
    background-color: #303030;
    border: 1px solid #444444;
}

QMenu::item {
    padding: 5px 24px 5px 24px;
}

QMenu::item:selected {
    background-color: #375a7f;
}

QMenu::item:disabled {
    color: #adb5bd;
}

QMenu::separator {
    height: 1px;
    background-color: #444444;
    margin: 4px 8px;
}

/* --- Search box ------------------------------------------------------- */

QLineEdit {
    background-color: #2f2f2f;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 5px;
}

QLineEdit:focus {
    border-color: #375a7f;
}

/* --- Category tree ---------------------------------------------------- */

QTreeWidget {
    border: 1px solid #444444;
    outline: none;
}

QTreeWidget:focus {
    border-color: #375a7f;
}

QTreeWidget::item {
    padding: 3px;
}

QTreeWidget::item:hover:!selected {
    background-color: #303030;
}

QTreeWidget::item:selected {
    background-color: #375a7f;
    color: #ffffff;
}

QTreeWidget::branch {
    background-color: #222222;
}

/* The F2 rename box sits inside a row; the search box padding above
   would squeeze its text and clip it. */
QTreeWidget QLineEdit {
    padding: 0px;
    margin: 0px;
    border: 1px solid #375a7f;
    border-radius: 0px;
}

/* --- Tabs ------------------------------------------------------------- */

QTabWidget::pane {
    border: 1px solid #444444;
}

QTabBar::tab {
    color: #adb5bd;
    background-color: #303030;
    border: 1px solid #444444;
    padding: 5px 16px;
    margin-right: 2px;
}

QTabBar::tab:hover {
    color: #ffffff;
}

QTabBar::tab:selected {
    color: #ffffff;
    background-color: #375a7f;
    border-color: #375a7f;
}

/* --- Editors ---------------------------------------------------------- */

QPlainTextEdit {
    background-color: #222222;
    border: none;
    padding: 6px;
    font-family: "Cascadia Mono", "Consolas", "Courier New", monospace;
    font-size: 11pt;
}

QPlainTextEdit:disabled {
    color: #adb5bd;
}

/* --- Buttons ---------------------------------------------------------- */

QPushButton {
    background-color: #444444;
    border: 1px solid #444444;
    border-radius: 3px;
    padding: 5px 14px;
    min-width: 64px;
}

QPushButton:hover {
    background-color: #555555;
}

QPushButton:focus {
    border-color: #375a7f;
}

QPushButton:pressed {
    background-color: #375a7f;
}

QPushButton:disabled {
    background-color: #303030;
    color: #adb5bd;
}

/* --- Splitter --------------------------------------------------------- */

QSplitter::handle {
    background-color: #444444;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:hover {
    background-color: #375a7f;
}

/* --- Scroll bars ------------------------------------------------------ */

QScrollBar:vertical {
    background-color: #222222;
    width: 12px;
}

QScrollBar:horizontal {
    background-color: #222222;
    height: 12px;
}

QScrollBar::handle:vertical {
    background-color: #555555;
    border-radius: 4px;
    min-height: 24px;
    margin: 2px;
}

QScrollBar::handle:horizontal {
    background-color: #555555;
    border-radius: 4px;
    min-width: 24px;
    margin: 2px;
}

QScrollBar::handle:hover {
    background-color: #adb5bd;
}

QScrollBar::add-line,
QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
}

/* --- Status bar ------------------------------------------------------- */

QStatusBar {
    background-color: #303030;
    border-top: 1px solid #444444;
}

QStatusBar::item {
    border: none;
}

/* --- Dialogs ---------------------------------------------------------- */

QToolTip {
    background-color: #303030;
    color: #ffffff;
    border: 1px solid #444444;
}
